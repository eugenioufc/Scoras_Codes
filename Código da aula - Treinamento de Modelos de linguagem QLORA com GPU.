import math, os, sys, torch

if sys.platform == "win32" and torch.cuda.is_available():
    torch_lib_dir = os.path.join(os.path.dirname(torch.__file__), "lib")
    if os.path.exists(torch_lib_dir):
        os.add_dll_directory(torch_lib_dir)

from transformers import AutoModelForCausalLM, AutoTokenizer, TrainingArguments, Trainer
from transformers import BitsAndBytesConfig, DataCollatorForLanguageModeling
from transformers.utils import is_bitsandbytes_available
from peft import LoraConfig, get_peft_model, TaskType, prepare_model_for_kbit_training
from datasets import load_dataset

use_q_lora = torch.cuda.is_available() and is_bitsandbytes_available()

base_id = "gpt2"
tokB = AutoTokenizer.from_pretrained(base_id)

if tokB.pad_token is None:
    tokB.pad_token = tokB.eos_token

raw_datasets = load_dataset("wikitext", "wikitext-2-raw-v1")
raw_datasets = raw_datasets.filter(lambda x: len(x["text"].strip()) > 0)

def tokenize_function(examples):
    return tokB(examples["text"], truncation=True, max_length=128)

lm_datasets = raw_datasets.map(
    tokenize_function,
    batched=True,
    remove_columns=["text"]
)

data_collator = DataCollatorForLanguageModeling(tokenizer=tokB, mlm=False)

print("QLORA:", use_q_lora)
if use_q_lora:
    bnb_cfg = BitsAndBytesConfig(
        load_in_4bit=True,
        bnb_4bit_quant_type="nf4",
        bnb_4bit_use_double_quant=True,
        bnb_4bit_compute_dtype=torch.bfloat16 if torch.cuda.is_available() else torch.float32
    )
    modelB = AutoModelForCausalLM.from_pretrained(base_id, quantization_config=bnb_cfg, device_map="auto")
    modelB = prepare_model_for_kbit_training(modelB)
    lora_cfg = LoraConfig(
        task_type=TaskType.CAUSAL_LM, 
        r=8, 
        lora_alpha=16, 
        lora_dropout=0.06,
        target_modules=["c_attn"]
    )
    modelB = get_peft_model(modelB, lora_cfg)
    modelB.config.use_cache = False
    modelB.print_trainable_parameters()
else: 
    modelB = AutoModelForCausalLM.from_pretrained(base_id, use_safetensors=True).to("cuda" if torch.cuda.is_available() else "cpu")

# Alinhamento do pad_token_id em ambos os configs do modelo para remover a mensagem
modelB.config.pad_token_id = tokB.pad_token_id
if hasattr(modelB, "generation_config") and modelB.generation_config is not None:
    modelB.generation_config.pad_token_id = tokB.pad_token_id

out_dirB = "runs/gpt2-wikitext2-qlora" if use_q_lora else "runs/gpt2-wikitext2-full"

argsB = TrainingArguments(
    output_dir=out_dirB,
    per_device_train_batch_size=1 if use_q_lora else 2,
    per_device_eval_batch_size=1 if use_q_lora else 2,
    gradient_accumulation_steps=8,
    num_train_epochs=1,
    learning_rate=1e-4,
    warmup_ratio=0.03,
    logging_steps=50,
    eval_strategy="steps",
    eval_steps=200,
    save_steps=500,
    save_total_limit=2,
    gradient_checkpointing_kwargs={"use_reentrant": False}
)

trainerB = Trainer(
    model=modelB, 
    args=argsB,
    train_dataset=lm_datasets["train"],
    eval_dataset=lm_datasets["validation"],
    processing_class=tokB,
    data_collator=data_collator
)

if torch.cuda.is_available():
    train_res = trainerB.train()
    eval_res = trainerB.evaluate()
    pplB = math.exp(eval_res["eval_loss"]) if eval_res["eval_loss"] < 20 else float("inf")
    print("eval:", eval_res, "| perplexity:", pplB)
    trainerB.save_model(out_dirB)
    tokB.save_pretrained(out_dirB)

    print("salvo em:", out_dirB)
else:
    print("sem gpu,etapa pulada")
